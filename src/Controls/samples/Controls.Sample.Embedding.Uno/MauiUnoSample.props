<Project>
  <PropertyGroup>
    <MauiUnoTarget>true</MauiUnoTarget>
    <_MauiUnoUsesSampleRuntimeIdentifier Condition="'$(UnoSampleRuntimeIdentifier)' != ''">true</_MauiUnoUsesSampleRuntimeIdentifier>
    <!-- The heads set Debug/Release defaults before this import; re-apply the explicit sample RID afterwards. -->
    <RuntimeIdentifier Condition="'$(_MauiUnoUsesSampleRuntimeIdentifier)' == 'true' and '$(RuntimeIdentifier)' != '$(UnoSampleRuntimeIdentifier)'">$(UnoSampleRuntimeIdentifier)</RuntimeIdentifier>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
  </PropertyGroup>
  <Import Project="$(MauiSrcDirectory)UnoTargeting.props" />
  <PropertyGroup>
    <_MauiUnoBuildProperties>$(_MauiUnoProjectReferenceProperties)</_MauiUnoBuildProperties>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <BuildInParallel>false</BuildInParallel>
    <UnoDisableHotRestartHelperGeneration>true</UnoDisableHotRestartHelperGeneration>
    <NoWarn>$(NoWarn);Uno0001;IL2072;IL2111;RS0030</NoWarn>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>TargetFrameworks;RuntimeIdentifiers;SelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Core\src\Core.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Essentials\src\Essentials.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Graphics\src\Graphics\Graphics.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Graphics\src\Graphics.Skia\Graphics.Skia.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\src\Core\Controls.Core.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\src\Xaml\Controls.Xaml.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <!--
      Referenced by every head, not just by the Shared project. Transitive project references are disabled
      above, so a head that only referenced Shared would build and run on Desktop — where the assembly is
      copied to the output folder anyway — but silently omit this assembly from a WebAssembly publish,
      whose asset set is computed from the head's own resolved references.
    -->
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\src\Embedding.Uno\Microsoft.Maui.Controls.Embedding.Uno.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
  </ItemGroup>
</Project>
