<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Maui.Controls.Sample.Uno</RootNamespace>
    <IsUnoHead>true</IsUnoHead>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <Import Project="..\MauiUnoSample.props" />

  <!--
    Opt-in verification build: the browser head cannot read an environment variable, so the probe is
    enabled by a build switch instead. Set as its own property rather than DefineConstants on the command
    line, which would replace the project's constants instead of adding to them.
  -->
  <PropertyGroup Condition="'$(MauiUnoTier2Probe)' == 'true'">
    <DefineConstants>$(DefineConstants);TIER2_PROBE</DefineConstants>
  </PropertyGroup>

  <!--
    Selects the full handler set. The browser cannot set an environment variable and the query string does
    not reach Environment.GetCommandLineArgs here, so the mode has to be baked in; publish twice to compare.
  -->
  <PropertyGroup Condition="'$(MauiUnoFullHandlers)' == 'true'">
    <DefineConstants>$(DefineConstants);FULL_HANDLERS</DefineConstants>
  </PropertyGroup>

  <!--
    The third-party trim analysis is suppressed inside the assemblies that need it, in
    ThirdParty/TrimSuppressions.cs, rather than with a NoWarn here. A NoWarn on this head would suppress the
    same diagnostics for the sample's own code, and IL2026 has already caught two real string-path bindings
    there.
  -->

  <ItemGroup>
    <PackageReference Include="Uno.Wasm.Bootstrap" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.WebAssembly.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Shared\Controls.Sample.Embedding.Uno.Shared.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
  </ItemGroup>

  <Target Name="_MauiUnoConfigureWasmMainAssembly" AfterTargets="GenerateUnoWasmAssets">
    <PropertyGroup>
      <_MauiUnoWasmConfigPath>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'unowwwrootassets', 'uno-config.js'))</_MauiUnoWasmConfigPath>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_MauiUnoWasmConfigPath)')"
      Text="Uno WebAssembly configuration was not generated at '$(_MauiUnoWasmConfigPath)'." />
    <WriteLinesToFile
      Condition="$([System.IO.File]::ReadAllText('$(_MauiUnoWasmConfigPath)').Contains('config.uno_main')) != 'True'"
      File="$(_MauiUnoWasmConfigPath)"
      Lines="config.uno_main = &quot;$(AssemblyName)&quot;"
      Overwrite="false"
      Encoding="UTF-8" />
  </Target>

</Project>
