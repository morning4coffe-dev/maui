<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Maui.Controls.Sample.Uno</RootNamespace>
    <IsUnoHead>true</IsUnoHead>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>

  <Import Project="..\MauiUnoSample.props" />

  <ItemGroup>
    <PackageReference Include="Uno.Wasm.Bootstrap" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.WebAssembly.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Shared\Controls.Sample.Embedding.Uno.Shared.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
  </ItemGroup>

  <Target Name="_MauiUnoConfigureWasmMainAssembly" AfterTargets="GenerateUnoWasmAssets">
    <PropertyGroup>
      <_MauiUnoWasmConfigPath>$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'unowwwrootassets', 'uno-config.js'))</_MauiUnoWasmConfigPath>
    </PropertyGroup>

    <Error
      Condition="!Exists('$(_MauiUnoWasmConfigPath)')"
      Text="Uno WebAssembly configuration was not generated at '$(_MauiUnoWasmConfigPath)'." />
    <WriteLinesToFile
      Condition="$([System.IO.File]::ReadAllText('$(_MauiUnoWasmConfigPath)').Contains('config.uno_main')) != 'True'"
      File="$(_MauiUnoWasmConfigPath)"
      Lines="config.uno_main = &quot;$(AssemblyName)&quot;"
      Overwrite="false"
      Encoding="UTF-8" />
  </Target>

</Project>
