<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Microsoft.Maui.Controls.Sample.Uno</RootNamespace>
    <ApplicationTitle>MAUI on Uno</ApplicationTitle>
    <ApplicationId>org.unoplatform.mauirenderer</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug'">android-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <IsUnoHead>true</IsUnoHead>
  </PropertyGroup>

  <Import Project="..\MauiUnoSample.props" />

  <ItemGroup>
    <PackageReference Include="Uno.WinUI.Runtime.Skia.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Shared\Controls.Sample.Uno.Shared.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
  </ItemGroup>

</Project>
