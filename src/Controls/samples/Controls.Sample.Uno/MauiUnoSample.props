<Project>
  <PropertyGroup>
    <MauiUnoTarget>true</MauiUnoTarget>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
  </PropertyGroup>

  <Import Project="$(MauiSrcDirectory)UnoTargeting.props" />

  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(UnoSampleRuntimeIdentifier)' != ''">$(UnoSampleRuntimeIdentifier)</RuntimeIdentifier>
    <_MauiUnoBuildProperties>MauiUnoTarget=true;IncludeAndroidTargetFrameworks=false;IncludeIosTargetFrameworks=false;IncludeMacCatalystTargetFrameworks=false;IncludeMacOSTargetFrameworks=false;IncludeTizenTargetFrameworks=false;IncludeWindowsTargetFrameworks=false;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;BuildInParallel=false;RestoreAdditionalProjectSources=https://api.nuget.org/v3/index.json</_MauiUnoBuildProperties>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <BuildInParallel>false</BuildInParallel>
    <UnoDisableHotRestartHelperGeneration>true</UnoDisableHotRestartHelperGeneration>
    <!-- The IL20xx diagnostics originate in the fully rooted CommunityToolkit assemblies below. -->
    <NoWarn>$(NoWarn);Uno0001;IL2062;IL2072;IL2089;IL2092;IL2111;IL2112;RS0030</NoWarn>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>TargetFrameworks;RuntimeIdentifiers;SelfContained</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Uno.WinUI" />
    <!-- Force neutral third-party assets; platform heads must not select MAUI's native handlers. -->
    <PackageDownload
      Include="CommunityToolkit.Maui"
      Version="[$(UnoCommunityToolkitMauiPackageVersion)]" />
    <PackageDownload
      Include="CommunityToolkit.Maui.Core"
      Version="[$(UnoCommunityToolkitMauiPackageVersion)]" />
    <Reference
      Include="CommunityToolkit.Maui"
      HintPath="$(NuGetPackageRoot)communitytoolkit.maui/$(UnoCommunityToolkitMauiPackageVersion)/lib/net10.0/CommunityToolkit.Maui.dll"
      Private="true" />
    <Reference
      Include="CommunityToolkit.Maui.Core"
      HintPath="$(NuGetPackageRoot)communitytoolkit.maui.core/$(UnoCommunityToolkitMauiPackageVersion)/lib/net10.0/CommunityToolkit.Maui.Core.dll"
      Private="true" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="CommunityToolkit.Maui" />
    <TrimmerRootAssembly Include="CommunityToolkit.Maui.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Core\src\Core.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Essentials\src\Essentials.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\..\Graphics\src\Graphics\Graphics.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\src\Core\Controls.Core.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\..\src\Xaml\Controls.Xaml.csproj"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties)" />
  </ItemGroup>

  <Target Name="_ConfigureMauiUnoRestoreGraph"
          BeforeTargets="_GenerateRestoreProjectPathWalk;_GenerateRestoreGraph"
          Condition="'$(MauiUnoTarget)' == 'true'">
    <PropertyGroup>
      <_GenerateRestoreGraphProjectEntryInputProperties>
        $(_GenerateRestoreGraphProjectEntryInputProperties);
        $(_MauiUnoBuildProperties)
      </_GenerateRestoreGraphProjectEntryInputProperties>
    </PropertyGroup>
  </Target>
</Project>
