<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(UnoMauiRuntimeIdentifier)</RuntimeIdentifier>
    <_ExpectedUnoMauiTrimMode>expected</_ExpectedUnoMauiTrimMode>
    <UnoMauiTrimMode Condition="'$(UnoMauiTrimMode)' == ''">partial</UnoMauiTrimMode>
    <TrimMode>$(UnoMauiTrimMode)</TrimMode>
  </PropertyGroup>

  <Target Name="Validate">
    <Error Condition="'$(UnoMauiTrimMode)' != '$(_ExpectedUnoMauiTrimMode)' or '$(TrimMode)' != '$(_ExpectedUnoMauiTrimMode)'"
           Text="The generated host evaluated UnoMauiTrimMode='$(UnoMauiTrimMode)' and TrimMode='$(TrimMode)' instead of '$(_ExpectedUnoMauiTrimMode)'." />
    <Error Condition="'$(MauiUnoTarget)' != 'true'"
           Text="The generated host lost its Uno identity." />
    <Error Condition="'$(TargetFramework)' != 'net10.0' or '$(OutputType)' != 'Exe' or '$(RuntimeIdentifier)' != 'browser-wasm' or '$(UnoMauiRuntimeIdentifier)' != 'browser-wasm'"
           Text="The generated host did not remove inherited application globals before restoring its executable browser role." />
  </Target>

  <Target Name="Restore" DependsOnTargets="Validate" />
  <Target Name="Build" DependsOnTargets="Validate" />
  <Target Name="Publish" DependsOnTargets="Validate" />
</Project>
