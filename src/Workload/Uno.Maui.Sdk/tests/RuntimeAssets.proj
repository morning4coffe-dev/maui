<Project DefaultTargets="Test">
  <PropertyGroup>
    <UnoMauiSkipSourceImport>true</UnoMauiSkipSourceImport>
    <UnoMauiTarget>WebAssembly</UnoMauiTarget>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
    <TargetDir>$(BaseIntermediateOutputPath)app\</TargetDir>
  </PropertyGroup>
  <ItemGroup>
    <NativeFileReference Include="$(BaseIntermediateOutputPath)native &amp; assets\sqlite.a" />
    <NativeFileReference Include="$(BaseIntermediateOutputPath)native &amp; assets\shared.a" />
  </ItemGroup>
  <Import Project="..\Sdk\Uno.Maui.Sdk.targets" />

  <Target Name="Initialize">
    <MakeDir Directories="$(TargetDir);$(BaseIntermediateOutputPath)native &amp; assets" />
    <WriteLinesToFile File="$(TargetDir)App.dll" Lines="app" Overwrite="true" />
    <WriteLinesToFile File="$(TargetDir)Dependency.dll" Lines="dependency" Overwrite="true" />
    <WriteLinesToFile File="$(TargetDir)Existing.dll" Lines="host dependency" Overwrite="true" />
    <WriteLinesToFile File="$(TargetDir)System.Runtime.dll" Lines="framework" Overwrite="true" />
    <WriteLinesToFile File="$(TargetDir)libSkiaSharp.dll" Lines="native" Overwrite="true" />
    <WriteLinesToFile File="%(NativeFileReference.Identity)" Lines="native archive" Overwrite="true" />
  </Target>

  <Target Name="Build">
    <Error Condition="'$(CopyLocalLockFileAssemblies)' != 'true'"
           Text="Generated hosts must build the application with its runtime package dependencies." />
  </Target>

  <Target Name="ValidateMinimalEmbeddingDependencies">
    <PropertyGroup>
      <_MinimalRoot>$(MSBuildThisFileDirectory)..\..\..\Controls\samples\Controls.Sample.Embedding.Uno.Minimal\</_MinimalRoot>
      <_MinimalApplication>$([System.IO.File]::ReadAllText('$(_MinimalRoot)MinimalUnoApp.cs'))</_MinimalApplication>
    </PropertyGroup>
    <XmlPeek XmlInputPath="$(_MinimalRoot)Controls.Sample.Embedding.Uno.Minimal.WebAssembly.csproj"
             Query="/Project/ItemGroup/PackageReference/@Include">
      <Output TaskParameter="Result" ItemName="_MinimalDependencies" />
    </XmlPeek>
    <Error Condition="'@(_MinimalDependencies->WithMetadataValue('Identity', 'Uno.WinUI.Lottie')->Count())' != '1'"
           Text="Minimal embedding must include the ProgressRing provider." />
    <Error Condition="'@(_MinimalDependencies->WithMetadataValue('Identity', 'Uno.WinUI.Graphics2DSK')->Count())' != '1'"
           Text="Minimal embedding must include the provider's Graphics2DSK dependency." />
    <Error Condition="'@(_MinimalDependencies->WithMetadataValue('Identity', 'SkiaSharp.Skottie')->Count())' != '1'"
           Text="Minimal embedding must include the provider's Skottie dependency." />
    <Error Condition="$(_MinimalApplication.Contains('ApiExtensibility.Register')) != 'True' or $(_MinimalApplication.Contains('ILottieVisualSourceProvider')) != 'True'"
           Text="The code-only minimal embedding root must register its animation provider." />
  </Target>

  <Target Name="Test" DependsOnTargets="Initialize;_UnoMauiBuildApplication;_UnoMauiExportApplicationResources;ValidateMinimalEmbeddingDependencies">
    <Error Condition="'$(_UnoMauiApplicationTargetDir)' != '$(TargetDir)'" Text="Application output path was lost." />
    <MSBuild Projects="RuntimeAssetsHost.proj"
             Properties="UnoMauiResourceManifest=$(_UnoMauiResourceManifest);UnoMauiAppTargetDir=$(TargetDir);UnoMauiAppProject=$(TargetDir)App.csproj" />
    <MSBuild Projects="GeneratedResources.Tests.proj" Properties="DeduplicateResources=false" />
    <MSBuild Projects="GeneratedResources.Tests.proj" Properties="DeduplicateResources=true" />
    <MSBuild Projects="GeneratedResources.Tests.proj" Properties="DeduplicateResources=false;InheritedResources=true" />
    <MSBuild Projects="GeneratedResources.Tests.proj" Properties="DeduplicateResources=true;InheritedResources=true" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" Properties="UseDefaultWin32Version=true" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" Properties="SdkDefaults=Source" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" Properties="SdkDefaults=Source;UseDefaultWin32Version=true" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" Properties="SdkDefaults=Package" />
    <MSBuild Projects="RuntimeVersionOverrides.Tests.proj" Properties="SdkDefaults=Package;UseDefaultWin32Version=true" />
    <MSBuild Projects="RuntimeVersionPropagation.Tests.proj" />
    <MSBuild Projects="RuntimeVersionPropagation.Tests.proj" Properties="UseDefaultWin32Version=true" />
    <MSBuild Projects="RuntimeVersionPropagation.Tests.proj" Properties="ProbeStaticWebAssets=false" />
    <MSBuild Projects="StaticWebAssetsPropagation.Tests.proj" />
    <MSBuild Projects="StaticWebAssetsPropagation.Tests.proj" Properties="ProbeStaticWebAssets=false" />
    <MSBuild Projects="StaticWebAssetsReference.Tests.proj" />
    <MSBuild Projects="StaticWebAssetsReference.Tests.proj" Properties="UnoMauiGenerateStaticWebAssets=false" />
    <MSBuild Projects="PackageInputPaths.Tests.proj" />
    <MSBuild Projects="SourceProjectReferences.Tests.proj" RemoveProperties="MauiUnoTarget;TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="SourceProjectReferences.Tests.proj" Properties="ProbeRuntimeIdentifier=browser-wasm" RemoveProperties="MauiUnoTarget;TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="SourceProjectReferences.Tests.proj" Properties="ProbeRuntimeIdentifier=win-x64" RemoveProperties="MauiUnoTarget;TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="SourceProjectReferences.Tests.proj" Properties="ProbeUno=false" RemoveProperties="MauiUnoTarget;TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="SourceProjectReferences.Tests.proj" Properties="ProbeFramework=netstandard2.0" RemoveProperties="MauiUnoTarget;TargetFramework;RuntimeIdentifier" />
    <MSBuild Projects="PublicPackageFeed.Tests.proj" RemoveProperties="UnoMauiPublicPackageFeed;ExpectedFeed" />
    <MSBuild Projects="PublicPackageFeed.Tests.proj"
             Properties="UnoMauiPublicPackageFeed=https://mirror.example.invalid/index.json;ExpectedFeed=https://mirror.example.invalid/index.json" />
    <MSBuild Projects="HeadDependencies.Tests.proj" Properties="Profile=GeneratedPackage" RemoveProperties="_MauiBuildTasksLocation" />
    <MSBuild Projects="HeadDependencies.Tests.proj" Properties="Profile=GeneratedSource" RemoveProperties="_MauiBuildTasksLocation" />
    <MSBuild Projects="HeadDependencies.Tests.proj" Properties="Profile=Minimal" RemoveProperties="_MauiBuildTasksLocation" />
    <MSBuild Projects="HeadDependencies.Tests.proj" Properties="Profile=Embedding" RemoveProperties="_MauiBuildTasksLocation" />
    <MSBuild Projects="AndroidHeadPolicy.Tests.proj" Properties="Profile=Generated" />
    <MSBuild Projects="AndroidHeadPolicy.Tests.proj" Properties="Profile=Minimal" />
    <MSBuild Projects="AndroidHeadPolicy.Tests.proj" Properties="Profile=Embedding" />
  </Target>
</Project>
