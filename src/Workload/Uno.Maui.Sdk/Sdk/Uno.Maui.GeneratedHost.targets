<Project>
  <PropertyGroup>
    <ResizetizerIncludeSelfProject Condition="'$(UnoMauiTarget)' != 'Android'">true</ResizetizerIncludeSelfProject>
    <ResizetizerPlatformType Condition="'$(UnoMauiTarget)' != 'Android'">uwp</ResizetizerPlatformType>
  </PropertyGroup>

  <ItemGroup>
    <_UnoMauiApplicationRuntimeAssembly
      Include="$(UnoMauiAppTargetDir)*.dll"
      Exclude="$(UnoMauiAppTargetDir)$([System.IO.Path]::GetFileNameWithoutExtension('$(UnoMauiAppProject)')).dll;$(UnoMauiAppTargetDir)libSkiaSharp.dll"
      Condition="'$(UnoMauiAppTargetDir)' != '' and Exists('$(UnoMauiAppTargetDir)')" />
    <!-- Included items retain their metadata; qualified source metadata is empty during evaluation. -->
    <MauiImage Include="@(_UnoMauiGeneratedImage)" Link="%(LogicalName)" />
    <MauiIcon Include="@(_UnoMauiGeneratedIcon)" Link="%(LogicalName)" />
    <MauiSplashScreen Include="@(_UnoMauiGeneratedSplashScreen)" Link="%(LogicalName)" />
    <MauiAsset Include="@(_UnoMauiGeneratedAsset)" Link="%(LogicalName)" />
    <MauiFont Include="@(_UnoMauiGeneratedFont)" Link="%(LogicalName)" />
  </ItemGroup>

  <Target Name="_UnoMauiAddApplicationRuntimeReferences"
          DependsOnTargets="ResolveRuntimePackAssets"
          BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_UnoMauiApplicationManagedAssembly Include="@(_UnoMauiApplicationRuntimeAssembly)" />
      <_UnoMauiApplicationManagedAssembly Remove="@(RuntimePackAsset)"
                                          MatchOnMetadata="Filename;Extension" />
      <_UnoMauiApplicationManagedAssembly Remove="@(Reference)"
                                          MatchOnMetadata="Filename;Extension" />
      <Reference Include="@(_UnoMauiApplicationManagedAssembly)">
        <HintPath>%(_UnoMauiApplicationManagedAssembly.Identity)</HintPath>
        <Private>true</Private>
      </Reference>
      <_UnoMauiApplicationNativeFileReference Include="@(_UnoMauiGeneratedNativeFileReference)" />
      <_UnoMauiApplicationNativeFileReference Remove="@(NativeFileReference)" MatchOnMetadata="FullPath" />
      <NativeFileReference Include="@(_UnoMauiApplicationNativeFileReference)" />
    </ItemGroup>
  </Target>

  <Target Name="_UnoMauiDeduplicateCollectedResources"
          AfterTargets="ResizetizeCollectItems">
    <ItemGroup>
      <MauiImage Remove="@(_UnoMauiGeneratedImage);@(_UnoMauiGeneratedIcon)" />
      <MauiImage Include="@(_UnoMauiGeneratedImage)" Link="%(LogicalName)" />
      <MauiImage Include="@(_UnoMauiGeneratedIcon)" Link="%(LogicalName)" IsAppIcon="True" />
      <MauiFont Remove="@(_UnoMauiGeneratedFont)" />
      <MauiFont Include="@(_UnoMauiGeneratedFont)" Link="%(LogicalName)" />
      <MauiAsset Remove="@(_UnoMauiGeneratedAsset)" />
      <MauiAsset Include="@(_UnoMauiGeneratedAsset)" Link="%(LogicalName)" />
      <MauiSplashScreen Remove="@(_UnoMauiGeneratedSplashScreen)" />
      <MauiSplashScreen Include="@(_UnoMauiGeneratedSplashScreen)" Link="%(LogicalName)" />
    </ItemGroup>
  </Target>

  <Target Name="_UnoMauiPackageGeneratedResources"
          Condition="'$(UnoMauiTarget)' != 'Android'"
          AfterTargets="ProcessMauiUnoAssets"
          DependsOnTargets="ResizetizeCollectItems;ProcessMauiAssets;ProcessMauiFonts;ResizetizeImages">
    <ItemGroup>
      <ContentWithTargetPath Include="@(_ResizetizerCollectedImages)"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest">
        <TargetPath>%(_ResizetizerCollectedImages.Filename)%(_ResizetizerCollectedImages.Extension)</TargetPath>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="@(_UnoMauiGeneratedImage)"
                             Condition="'$(UnoMauiTarget)' == 'WebAssembly' and '%(_UnoMauiGeneratedImage.Extension)' != '.svg'"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest">
        <TargetPath>%(_UnoMauiGeneratedImage.LogicalName)</TargetPath>
      </ContentWithTargetPath>
      <ContentWithTargetPath Include="@(_MauiFontCopied)"
                             CopyToOutputDirectory="PreserveNewest"
                             CopyToPublishDirectory="PreserveNewest">
        <TargetPath>%(_MauiFontCopied.Filename)%(_MauiFontCopied.Extension)</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
