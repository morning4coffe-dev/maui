<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <SampleProject>true</SampleProject>
    <AssemblyName>$(UnoMauiGeneratedProjectName)</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RollForward>Major</RollForward>
    <IsUnoHead>true</IsUnoHead>
    <UnoMauiDisableAppFactoryGeneration>true</UnoMauiDisableAppFactoryGeneration>
  </PropertyGroup>

  <Import Project="$(UnoMauiResourceManifest)" Condition="Exists('$(UnoMauiResourceManifest)')" />
  <Import Project="$(UnoMauiSdkRoot)Sdk\Uno.Maui.Source.props" />
  <Import Project="$(UnoMauiSdkRoot)Sdk\Uno.Maui.GeneratedHost.targets" />

  <ItemGroup>
    <PackageReference Include="Uno.WinUI.Runtime.Skia.Linux.FrameBuffer" Version="$(UnoMauiUnoVersion)" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.MacOS" Version="$(UnoMauiUnoVersion)" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.Win32" Version="$(UnoMauiUnoVersion)" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.X11" Version="$(UnoMauiUnoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="$(UnoMauiAppProject)"
      AdditionalProperties="$(_MauiUnoBuildProperties);UnoMauiDisableResourceItems=true"
      SkipGetTargetFrameworkProperties="true"
      SetTargetFramework="TargetFramework=net10.0;$(_MauiUnoBuildProperties);UnoMauiDisableResourceItems=true" />
  </ItemGroup>
</Project>
