<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <SampleProject>true</SampleProject>
    <AssemblyName>$(UnoMauiGeneratedProjectName)</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ApplicationTitle Condition="'$(UnoMauiApplicationTitle)' != ''">$(UnoMauiApplicationTitle)</ApplicationTitle>
    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">MAUI on Uno</ApplicationTitle>
    <ApplicationId>$(UnoMauiApplicationId)</ApplicationId>
    <ApplicationId Condition="'$(ApplicationId)' == ''">org.unoplatform.maui.generated</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifier Condition="'$(UnoMauiRuntimeIdentifier)' != ''">$(UnoMauiRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
    <AndroidEnableProfiledAot Condition="'$(Configuration)' == 'Release'">$(UnoMauiAndroidProfiledAot)</AndroidEnableProfiledAot>
    <MauiUseDefaultAotProfile Condition="'$(Configuration)' == 'Release' and '$(AndroidEnableProfiledAot)' == 'true'">false</MauiUseDefaultAotProfile>
    <AndroidUseDefaultAotProfile Condition="'$(Configuration)' == 'Release' and '$(AndroidEnableProfiledAot)' == 'true'">true</AndroidUseDefaultAotProfile>
    <DefineConstants Condition="'$(UnoMauiAndroidExtractNativeLibs)' == 'true'">$(DefineConstants);UNO_MAUI_ANDROID_EXTRACT_NATIVE_LIBS</DefineConstants>
    <DefineConstants Condition="'$(UnoMauiAndroidLargeHeap)' == 'true'">$(DefineConstants);UNO_MAUI_ANDROID_LARGE_HEAP</DefineConstants>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <IsUnoHead>true</IsUnoHead>
    <UnoMauiDisableAppFactoryGeneration>true</UnoMauiDisableAppFactoryGeneration>
  </PropertyGroup>

  <Import Project="$(UnoMauiResourceManifest)" Condition="Exists('$(UnoMauiResourceManifest)')" />
  <Import Project="$(UnoMauiSdkRoot)Sdk\Uno.Maui.Source.props" />
  <Import Project="$(UnoMauiSdkRoot)Sdk\Uno.Maui.GeneratedHost.targets" />

  <ItemGroup>
    <PackageReference Update="Uno.WinUI" VersionOverride="$(UnoMauiCoreRuntimeVersion)" Condition="'$(UnoMauiUseSource)' == 'true'" />
    <PackageReference Include="Uno.WinUI" Version="$(UnoMauiCoreRuntimeVersion)" VersionOverride="$(UnoMauiCoreRuntimeVersion)" Condition="'$(UnoMauiUseSource)' != 'true'" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.Android" Version="$(UnoMauiAndroidRuntimeVersion)" VersionOverride="$(UnoMauiAndroidRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Reference
      Include="$([System.IO.Path]::GetFileNameWithoutExtension('$(UnoMauiAppProject)'))"
      Condition="'$(UnoMauiAppTargetDir)' != ''">
      <HintPath>$(UnoMauiAppTargetDir)$([System.IO.Path]::GetFileNameWithoutExtension('$(UnoMauiAppProject)')).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Import Project="Uno.Maui.AndroidHost.targets" />
</Project>
