<Project>
  <PropertyGroup Condition="'$(MauiUnoTarget)' == 'true' and '$(TargetFramework)' == '$(_MauiDotNetTfm)'">
    <_MauiTargetPlatformIsUno>True</_MauiTargetPlatformIsUno>
    <_MauiTargetPlatformIsWindows>True</_MauiTargetPlatformIsWindows>
    <_MauiNoTargetPlatform>False</_MauiNoTargetPlatform>
    <DefineConstants>WINDOWS;PLATFORM;UNO;$(DefineConstants)</DefineConstants>
    <PublicApiType>Validate</PublicApiType>
    <!-- Uno0001 tracks known API gaps in this experiment; the other diagnostics originate in generated XAML. -->
    <NoWarn>$(NoWarn);Uno0001;IL2072;IL2111;RS0030</NoWarn>
  </PropertyGroup>
</Project>
