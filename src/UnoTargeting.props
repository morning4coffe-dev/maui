<Project>
  <PropertyGroup Condition="'$(MauiUnoTarget)' == 'true'">
    <MauiUnoRenderer Condition="'$(MauiUnoRenderer)' == ''">WinUI</MauiUnoRenderer>
    <MauiUnoHostPlatform Condition="'$(MauiUnoHostPlatform)' == ''">Neutral</MauiUnoHostPlatform>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
    <_MauiUnoProjectReferenceProperties>MauiUnoTarget=true;MauiUnoRenderer=$(MauiUnoRenderer);MauiUnoHostPlatform=$(MauiUnoHostPlatform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;BuildInParallel=false;IncludeAndroidTargetFrameworks=false;IncludeIosTargetFrameworks=false;IncludeMacCatalystTargetFrameworks=false;IncludeMacOSTargetFrameworks=false;IncludeTizenTargetFrameworks=false;IncludeWindowsTargetFrameworks=false;RestoreAdditionalProjectSources=https://api.nuget.org/v3/index.json</_MauiUnoProjectReferenceProperties>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MauiUnoTarget)' == 'true' and '$(MauiUnoRenderer)' == 'WinUI' and '$(TargetFramework)' == '$(_MauiDotNetTfm)'">
    <_MauiTargetPlatformIsUno>True</_MauiTargetPlatformIsUno>
    <_MauiTargetPlatformIsWindows>True</_MauiTargetPlatformIsWindows>
    <_MauiNoTargetPlatform>False</_MauiNoTargetPlatform>
    <DefineConstants>WINDOWS;PLATFORM;UNO;$(DefineConstants)</DefineConstants>
    <PublicApiType>Validate</PublicApiType>
    <!-- Uno0001 tracks known API gaps in this experiment; the other diagnostics originate in generated XAML. -->
    <NoWarn>$(NoWarn);Uno0001;IL2072;IL2111;RS0030</NoWarn>
  </PropertyGroup>
  <Target Name="_ValidateMauiUnoRenderer" BeforeTargets="PrepareForBuild" Condition="'$(MauiUnoTarget)' == 'true'">
    <Error Condition="'$(MauiUnoRenderer)' != 'WinUI'" Text="MauiUnoRenderer must be 'WinUI' for the current renderer implementation." />
  </Target>
  <Target Name="_MauiUnoNormalizeTransitiveRuntimeReferences"
          AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(MauiUnoTarget)' == 'true' and '$(TargetFramework)' == '$(_MauiDotNetTfm)'">
    <PropertyGroup>
      <_MauiUnoCoreProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Core', 'src', 'Core.csproj'))</_MauiUnoCoreProject>
      <_MauiUnoEssentialsProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Essentials', 'src', 'Essentials.csproj'))</_MauiUnoEssentialsProject>
      <_MauiUnoGraphicsProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Graphics', 'src', 'Graphics', 'Graphics.csproj'))</_MauiUnoGraphicsProject>
      <_MauiUnoSkiaGraphicsProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Graphics', 'src', 'Graphics.Skia', 'Graphics.Skia.csproj'))</_MauiUnoSkiaGraphicsProject>
      <_MauiUnoControlsProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Controls', 'src', 'Core', 'Controls.Core.csproj'))</_MauiUnoControlsProject>
      <_MauiUnoXamlProject>$([MSBuild]::NormalizePath('$(MauiSrcDirectory)', 'Controls', 'src', 'Xaml', 'Controls.Xaml.csproj'))</_MauiUnoXamlProject>
    </PropertyGroup>
    <ItemGroup>
      <!-- SDK-injected edges must share the explicit edges' identity, not race for the same outputs. -->
      <ProjectReference Update="@(_TransitiveProjectReferences)"
                        Condition="'%(ProjectReference.FullPath)' == '$(_MauiUnoCoreProject)' or
                                   '%(ProjectReference.FullPath)' == '$(_MauiUnoEssentialsProject)' or
                                   '%(ProjectReference.FullPath)' == '$(_MauiUnoGraphicsProject)' or
                                   '%(ProjectReference.FullPath)' == '$(_MauiUnoSkiaGraphicsProject)' or
                                   '%(ProjectReference.FullPath)' == '$(_MauiUnoControlsProject)' or
                                   '%(ProjectReference.FullPath)' == '$(_MauiUnoXamlProject)'">
        <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
        <SetTargetFramework>TargetFramework=$(TargetFramework);$(_MauiUnoProjectReferenceProperties)</SetTargetFramework>
      </ProjectReference>
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(MauiUnoTarget)' == 'true' and '$(ApplicationVersion)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Microsoft.Maui.ApplicationModel.AppInfo.BuildString</_Parameter1>
      <_Parameter2>$(ApplicationVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(MauiUnoTarget)' == 'true' and '$(ApplicationDisplayVersion)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Microsoft.Maui.ApplicationModel.AppInfo.DisplayVersion</_Parameter1>
      <_Parameter2>$(ApplicationDisplayVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
