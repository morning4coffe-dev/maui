+using Mono.Cecil.Cil;
+using System;
+using System.Collections.Generic;
+using System.Web.Script.Serialization;
+
+namespace ILRepacking.Steps
+{
+    internal sealed class SourceLinkRepackStep : IRepackStep
+    {
+        private readonly ILogger _logger;
+        private readonly IRepackContext _repackContext;
+
+        public SourceLinkRepackStep(ILogger logger, IRepackContext repackContext)
+        {
+            _logger = logger;
+            _repackContext = repackContext;
+        }
+
+        public void Perform()
+        {
+            var documents = new SortedDictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            var serializer = new JavaScriptSerializer();
+            foreach (var input in _repackContext.MergedAssemblies)
+            {
+                var sourceLinkRecords = 0;
+                foreach (var custom in input.MainModule.CustomDebugInformations)
+                {
+                    var sourceLink = custom as SourceLinkDebugInformation;
+                    if (sourceLink == null)
+                        continue;
+
+                    sourceLinkRecords++;
+                    if (sourceLinkRecords != 1)
+                        throw new InvalidOperationException("An input module contains multiple SourceLink records.");
+                    if (string.IsNullOrWhiteSpace(sourceLink.Content))
+                        throw new InvalidOperationException("SourceLink content must be nonempty JSON.");
+                    var root = serializer.DeserializeObject(sourceLink.Content) as IDictionary<string, object>;
+                    object value;
+                    var sourceDocuments = root != null && root.TryGetValue("documents", out value)
+                        ? value as IDictionary<string, object>
+                        : null;
+                    if (sourceDocuments == null || sourceDocuments.Count == 0)
+                        throw new InvalidOperationException("SourceLink must contain a nonempty documents object.");
+                    foreach (var document in sourceDocuments)
+                    {
+                        var url = document.Value as string;
+                        ValidatePattern(document.Key, url);
+                        string existing;
+                        if (documents.TryGetValue(document.Key, out existing) &&
+                            !string.Equals(existing, url, StringComparison.Ordinal))
+                            throw new InvalidOperationException("Merged SourceLink inputs disagree for " + document.Key);
+                        documents[document.Key] = url;
+                    }
+                }
+            }
+            if (documents.Count == 0)
+                return;
+
+            var content = serializer.Serialize(new Dictionary<string, object>
+            {
+                { "documents", documents }
+            });
+            _repackContext.TargetAssemblyMainModule.CustomDebugInformations.Add(
+                new SourceLinkDebugInformation(content));
+            _logger.Verbose("Wrote aggregated SourceLink json with " + documents.Count + " entries");
+        }
+
+        private static void ValidatePattern(string path, string url)
+        {
+            if (string.IsNullOrEmpty(path) || string.IsNullOrEmpty(url))
+                throw new InvalidOperationException("SourceLink document paths and URLs must be nonempty strings.");
+            var pathWildcard = path.IndexOf('*');
+            if (pathWildcard >= 0 && (pathWildcard != path.Length - 1 || path.LastIndexOf('*') != pathWildcard))
+                throw new InvalidOperationException("SourceLink document path has an invalid wildcard: " + path);
+            var urlWildcard = url.IndexOf('*');
+            if (pathWildcard < 0 && urlWildcard >= 0 ||
+                pathWildcard >= 0 && (urlWildcard < 0 || url.LastIndexOf('*') != urlWildcard))
+                throw new InvalidOperationException("SourceLink document path and URL wildcards do not correspond: " + path);
+        }
+    }
+}
